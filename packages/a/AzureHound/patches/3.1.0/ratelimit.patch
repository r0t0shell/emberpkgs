 	"time"
 
 	"github.com/bloodhoundad/azurehound/v2/config"
 	"github.com/bloodhoundad/azurehound/v2/constants"
+	"golang.org/x/time/rate"
 )
 
+// rateLimiterOnce ensures the process-wide HTTP rate limiter is only initialized once
+// so that throttling applies globally across every rest client.
+var (
+	rateLimiterOnce sync.Once
+	httpRateLimiter *rate.Limiter
+)
+
+func getHTTPRateLimiter() *rate.Limiter {
+	rateLimiterOnce.Do(func() {
+		if v := config.ColRateLimit.Value(); v != nil {
+			if rps, ok := v.(int); ok && rps > 0 {
+				httpRateLimiter = rate.NewLimiter(rate.Limit(rps), rps)
+			}
+		}
+	})
+	return httpRateLimiter
+}
+
+// rateLimitedTransport wraps an http.RoundTripper and blocks until the shared
+// rate limiter allows the request to proceed.
+type rateLimitedTransport struct {
+	base    http.RoundTripper
+	limiter *rate.Limiter
+}
+
+func (t *rateLimitedTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	ctx := req.Context()
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if err := t.limiter.Wait(ctx); err != nil {
+		return nil, err
+	}
+	return t.base.RoundTrip(req)
+}
+
 func NewHTTPClient(proxyUrl string) (*http.Client, error) {
 	transport := http.DefaultTransport.(*http.Transport).Clone()
 	transport.MaxConnsPerHost = config.ColMaxConnsPerHost.Value().(int)
@@ -62,9 +100,14 @@ func NewHTTPClient(proxyUrl string) (*http.Client, error) {
 		}
 	}
 
+	var roundTripper http.RoundTripper = transport
+	if limiter := getHTTPRateLimiter(); limiter != nil {
+		roundTripper = &rateLimitedTransport{base: transport, limiter: limiter}
+	}
+
 	return &http.Client{
 		Jar:       jar,
-		Transport: transport,
+		Transport: roundTripper,
 	}, nil
 }
 

